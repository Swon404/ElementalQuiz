    "react-test-renderer": "^19.2.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.4"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.14.0",
    "vite-plugin-pwa": "^1.2.0"
  }
